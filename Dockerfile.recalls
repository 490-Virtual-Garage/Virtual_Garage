FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY nhtsa_recalls.py recalls_service.py ./

EXPOSE 8000

CMD ["uvicorn", "recalls_service:app", "--host", "0.0.0.0", "--port", "8000"]
